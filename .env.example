# CineCraft AI — Production Environment Variables
# Copy this file to .env and fill in the values for your deployment.
# NEVER commit .env to GitHub or source control.

# Application Environment (production / development)
APP_ENV=production
PORT=8080

# Cloud Rendering Worker Configuration
RENDER_WORKER_TIMEOUT_SECONDS=300
MAX_AUTO_REPAIR_RETRIES=3
MAX_CONCURRENT_RENDERS=5

# Cloud Storage Bucket (Google Cloud Storage / S3)
STORAGE_BUCKET_NAME=gs://cinecraft-cloud-assets
STORAGE_PUBLIC_BASE_URL=https://storage.googleapis.com/cinecraft-cloud-assets

# Cloud Run Backend Endpoint (Custom or Cloud-Hosted API)
CLOUD_RUN_API_URL=https://cinecraft-run-451885523722.europe-west3.run.app

# Optional AI / LLM API Key (configure via Secrets panel in AI Studio)
# GEMINI_API_KEY=
